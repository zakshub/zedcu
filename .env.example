# Copy to .env for local development. Never commit real credentials.
# No provider keys are required for policy unit tests.
NODE_ENV=development

# Optional PostgreSQL runtime configuration. Leave commented until a database is approved.
# Use DATABASE_URL OR the PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD settings.
# DATABASE_URL=
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=zedcu
# PGUSER=zedcu_app
# PGPASSWORD=
# PGSSL=true
# PGPOOL_MAX=5
# PGIDLE_TIMEOUT_MS=30000
# PGCONNECT_TIMEOUT_MS=5000

# Authenticated HTTP API. Generate a random secret of at least 32 characters.
# ZEDCU_API_TOKEN=

# Optional OpenAI-compatible gateway for the worker. Never commit actual values.
# ZEDCU_GATEWAY_ID=openai-compatible
# ZEDCU_GATEWAY_BASE_URL=https://your-approved-gateway.example/v1
# ZEDCU_GATEWAY_API_KEY=
# ZEDCU_UPSTREAM_PROVIDER=your-upstream-provider
# ZEDCU_MODEL=exact-model-id
# ZEDCU_ROUTE_CONFIRMED_FREE=false
# ZEDCU_ROUTE_COST_USD_PER_MILLION_TOKENS=0
# ZEDCU_FREE_EVIDENCE_URL=https://official-provider.example/pricing
# ZEDCU_FREE_EVIDENCE_CHECKED_AT=2026-10-17T00:00:00.000Z
# ZEDCU_WORKER_ID=zedcu-worker-1
# ZEDCU_WORKER_LEASE_MS=60000
# ZEDCU_MAX_OUTPUT_TOKENS=1024
# Multi-route mode overrides the single-route variables above.
# Use environment-variable NAMES for baseUrlEnv/apiKeyEnv; never embed secret values.
# ZEDCU_ROUTES_JSON=[{"id":"route-one","gatewayId":"gateway-one","provider":"provider-one","model":"exact-model-id","baseUrlEnv":"GATEWAY_ONE_URL","apiKeyEnv":"GATEWAY_ONE_KEY","evidenceUrl":"https://official-provider.example/pricing","evidenceCheckedAt":"2026-10-17T00:00:00.000Z","confirmedFree":false,"costUsdPerMillionTokens":0,"priority":10,"capabilities":["text"]}]
# GATEWAY_ONE_URL=
# GATEWAY_ONE_KEY=
